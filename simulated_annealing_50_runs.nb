   "Funzione", " ", "per", " ", "stampare", " ", "il", " ", "percorso"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stampa", "[", "stato_", "]"}], ":=", 
    RowBox[{"StringJoin", "[", 
     RowBox[{"Riffle", "[", 
      RowBox[{
       RowBox[{"stato", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<nome\>\""}], "]"}], "]"}], ",", 
       "\"\<, \>\""}], "]"}], "]"}]}], ";"}], " ", "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Funzione", " ", "per", " ", "creare", " ", "uno", " ", "stato", " ", 
    "iniziale", " ", "con", " ", "Roma", " ", 
    RowBox[{"all", "'"}], "inizio"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"creaStatoIniziale", "[", 
    RowBox[{"citt\[AGrave]_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "scelte", "}"}], ",", 
     RowBox[{
      RowBox[{"scelte", "=", 
       RowBox[{"RandomSample", "[", 
        RowBox[{
         RowBox[{"citt\[AGrave]", "[", 
          RowBox[{"[", 
           RowBox[{"2", ";;", 
            RowBox[{"Length", "[", "citt\[AGrave]", "]"}]}], "]"}], "]"}], 
         ",", 
         RowBox[{"n", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"scelte", "=", 
       RowBox[{"Prepend", "[", 
        RowBox[{"scelte", ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<nome\>\"", "->", "\"\<Rome\>\""}], ",", 
           RowBox[{"\"\<lat\>\"", "->", "41.8992"}], ",", 
           RowBox[{"\"\<long\>\"", "->", "12.5450"}]}], "|>"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", "scelte"}]}], "]"}]}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Funzione", " ", "per", " ", "creare", " ", "un", " ", "nuovo", " ", 
    "stato"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"creaNuovoStato", "[", "stato_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rand1", ",", "rand2", ",", "minRand", ",", "maxRand", ",", 
       "invertito"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rand1", ",", "rand2"}], "}"}], "=", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", 
           RowBox[{"Length", "[", "stato", "]"}]}], "}"}], ",", "2"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"minRand", ",", "maxRand"}], "}"}], "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"{", 
         RowBox[{"rand1", ",", "rand2"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"invertito", "=", 
       RowBox[{"Reverse", "[", 
        RowBox[{"stato", "[", 
         RowBox[{"[", 
          RowBox[{"minRand", ";;", "maxRand"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"stato", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", 
           RowBox[{"minRand", "-", "1"}]}], "]"}], "]"}], ",", "invertito", 
        ",", 
        RowBox[{"stato", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"maxRand", "+", "1"}], ";;", 
           RowBox[{"Length", "[", "stato", "]"}]}], "]"}], "]"}]}], "]"}]}]}],
     "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"j", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nTest", "=", "50"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"minimiOttenuti", "=", 
    RowBox[{"{", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"j", "=", "1"}], ",", 
     RowBox[{"j", "<=", "nTest"}], ",", 
     RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"DEFINIZIONE", " ", "PARAMETRI", " ", "E", " ", "VARIABILI"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ntot", "=", "4"}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
       "numero", " ", "di", " ", "volte", " ", "in", " ", "cui", " ", 
        "ricomincia", " ", "la", " ", "ricerca", " ", "del", " ", "minimo", 
        " ", "a", " ", "partire", " ", "da", " ", "un", " ", "diverso", " ", 
        "stato", " ", "inziale"}], "*)"}], "\n", 
      RowBox[{"ntemp", "=", "20"}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{"numero", " ", "di", " ", "temperature"}], "*)"}], "\n", 
      RowBox[{"nsteps", "=", 
       RowBox[{"10", "*", "n"}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
       "numero", " ", "di", " ", "step", " ", "per", " ", "ogni", " ", 
        "temperatura"}], "*)"}], "\[IndentingNewLine]", "\n", 
      RowBox[{"beta0", "=", "0.1"}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{"valore", " ", "iniziale", " ", "di", " ", "beta", " ", 
        RowBox[{"(", 
         RowBox[{"alta", " ", "temperatura"}], ")"}]}], "*)"}], 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"counter", "=", "0"}], ";", "\n", 
      RowBox[{"itot", "=", "0"}], ";", "\n", 
      RowBox[{"itemp", "=", "0"}], ";", "\n", 
      RowBox[{"isteps", "=", "0"}], ";", "\n", "\[IndentingNewLine]", 
      RowBox[{"migliorPercorso", "=", 
       RowBox[{"creaStatoIniziale", "[", 
        RowBox[{"stato", ",", "n"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"migliorDistanza", "=", 
       RowBox[{"lunghezzaTot", "[", "migliorPercorso", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"NOTA", ":", 
         RowBox[{
         "migliorPercorso", " ", "e", " ", "migliorDistanza", " ", "sono", 
          " ", "le", " ", "due", " ", "variabili", " ", "che", " ", 
          "memorizzano"}]}], ",", "rispettivamente", ",", 
        RowBox[{
        "il", " ", "miglior", " ", "percorso", " ", "e", " ", "la", " ", 
         "miglior", " ", "distanza", " ", "trovata"}]}], "*)"}], 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"(*", 
       RowBox[{
       "Liste", " ", "per", " ", "raccogliere", " ", "i", " ", "dati"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"listaTemperature", "=", 
       RowBox[{"{", "}"}]}], ";", "\n", 
      RowBox[{"listaTemp", "=", 
       RowBox[{"{", "}"}]}], ";", "\n", 
      RowBox[{"miglioriDistanze", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"distanzeOttenute", "=", 
       RowBox[{"{", "}"}]}], ";", "\n", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Visualizzazione", " ", "del", " ", "percorso", " ", "iniziale"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Percorso iniziale: \>\"", "]"}], ";", "\n", 
      RowBox[{"Print", "[", 
       RowBox[{"stampa", "[", "migliorPercorso", "]"}], "]"}], ";", "\n", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Distanza iniziale(km): \>\"", ",", "migliorDistanza"}], 
       "]"}], ";", "\n", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"INIZIO", " ", 
        RowBox[{"DELL", "'"}], "ALGORITMO", " ", "SIMULATED", " ", 
        "ANNEALING"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"itot", "=", "1"}], ",", 
        RowBox[{"itot", "<=", "ntot"}], ",", 
        RowBox[{"itot", "++"}], ",", 
        RowBox[{
         RowBox[{"stato", "=", 
          RowBox[{"creaStatoIniziale", "[", 
           RowBox[{"stato", ",", "n"}], "]"}]}], ";", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "inizializzo", " ", "stato", " ", "con", " ", "lo", " ", "stato", 
            " ", "di", " ", "partenza", " ", "generato", " ", "per", " ", 
            RowBox[{"l", "'"}], "iterazione", " ", "i"}], "-", "esima"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"lunghezzaTot", "[", "stato", "]"}], "<", 
            "migliorDistanza"}], ",", 
           RowBox[{
            RowBox[{"migliorDistanza", "=", 
             RowBox[{"lunghezzaTot", "[", "stato", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"migliorPercorso", "=", "stato"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"counter", "++"}], ";"}]}], "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Print", "[", 
            RowBox[{"{", 
             RowBox[{
             "counter", ",", "itot", ",", "itemp", ",", "isteps", ",", 
              "\"\<Distanza ottimale(km):\>\"", ",", " ", "migliorDistanza"}],
              "}"}], "]"}], "*)"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"itemp", "=", "1"}], ",", 
           RowBox[{"itemp", "<=", "ntemp"}], ",", 
           RowBox[{"itemp", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"RAFFREDDAMENTO", " ", "GEOMETRICO"}], "*)"}], 
           RowBox[{
            RowBox[{"beta", "=", 
             RowBox[{"beta0", "*", "itemp"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"RAFFREDDAMENTO", " ", "LOGARITMICO"}], "*)"}], 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"beta", "=", 
               RowBox[{"beta0", "*", 
                RowBox[{"Log", "[", 
                 RowBox[{"1", "+", "itemp"}], "]"}]}]}], ";"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"isteps", "=", "1"}], ",", 
              RowBox[{"isteps", "<=", "nsteps"}], ",", 
              RowBox[{"isteps", "++"}], ",", 
              RowBox[{
               RowBox[{"nuovoStato", "=", 
                RowBox[{"creaNuovoStato", "[", "stato", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{
                "Calcoliamo", " ", "la", " ", "differenza", " ", "fra", " ", 
                 "la", " ", "distanza", " ", "totale", " ", "tra", " ", "il", 
                 " ", "percorso", " ", "\"\<nuovo\>\"", " ", "e", " ", 
                 "quello", " ", "\"\<vecchio\>\"", " ", "per", " ", 
                 "ottenere", " ", "il", " ", "costo"}], "*)"}], 
               "\[IndentingNewLine]", 
               RowBox[{"nuovaDistanza", "=", 
                RowBox[{"lunghezzaTot", "[", "nuovoStato", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"varCosto", "=", 
                RowBox[{"nuovaDistanza", "-", 
                 RowBox[{"lunghezzaTot", "[", "stato", "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"varCosto", "<", "0"}], "||", 
                  RowBox[{
                   RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "beta"}], "*", "varCosto"}], "]"}], ">", 
                   RowBox[{"RandomReal", "[", "]"}]}]}], ",", 
                 RowBox[{
                  RowBox[{"stato", "=", "nuovoStato"}], ";", 
                  RowBox[{"(*", 
                   RowBox[{
                   "nuovo", " ", "stato", " ", "accettato", " ", "se", " ", 
                    "la", " ", "distanza", " ", "totale", " ", "diminuisce", 
                    " ", "oppure", " ", "le", " ", "configurazioni", " ", 
                    "che", " ", "peggiorano", " ", "di", " ", "poco"}], 
                   "*)"}], "\[IndentingNewLine]", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"distanzeOttenute", ",", "nuovaDistanza"}], "]"}], 
                  ";", "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"nuovaDistanza", "<", "migliorDistanza"}], ",", 
                    RowBox[{"(*", 
                    RowBox[{
                    "stato", " ", "nuovo", " ", "\[EGrave]", " ", "il", " ", 
                    "migliore", " ", "trovato", " ", "finora"}], "*)"}], 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"migliorPercorso", "=", "nuovoStato"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"migliorDistanza", "=", "nuovaDistanza"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"counter", "++"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    "Memorizza", " ", "la", " ", "migliore", " ", "distanza", 
                    " ", "per", " ", "ogni", " ", "temperatura"}], "*)"}], 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"listaTemp", ",", "beta"}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"miglioriDistanze", ",", "migliorDistanza"}], 
                    "]"}], ";"}]}], "\[IndentingNewLine]", 
                   RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    "counter", ",", "itot", ",", "itemp", ",", "isteps", ",", 
                    "\"\<Distanza ottimale(km):\>\"", ",", 
                    "migliorDistanza"}], "}"}], "]"}], ";"}], "*)"}], "]"}]}],
                  ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"AppendTo", "[", 
                    RowBox[{"distanzeOttenute", ",", 
                    RowBox[{"lunghezzaTot", "[", "stato", "]"}]}], "]"}], 
                   ";"}], "\[IndentingNewLine]", ";"}]}], "]"}], ";"}]}], 
             "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"listaTemperature", ",", "beta"}], "]"}], ";"}]}], "]"}],
          ";"}]}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"minimiOttenuti", ",", "migliorDistanza"}], "]"}], ";", "\n", 
      "    ", 
      RowBox[{"Print", "[", 
