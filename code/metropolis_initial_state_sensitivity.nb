        RowBox[{"Reverse", "[", 
         RowBox[{"stato", "[", 
          RowBox[{"[", 
           RowBox[{"minRand", ";;", "maxRand"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"stato", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", 
            RowBox[{"minRand", "-", "1"}]}], "]"}], "]"}], ",", "invertito", 
         ",", 
         RowBox[{"stato", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"maxRand", "+", "1"}], ";;", 
            RowBox[{"Length", "[", "stato", "]"}]}], "]"}], "]"}]}], 
        "]"}]}]}], "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Funzione", " ", "per", " ", "stampare", " ", "i", " ", "nomi", " ", 
     "delle", " ", "citt\[AGrave]", " ", "nel", " ", "percorso", " ", 
     "minimo"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"stampaNomiPercorsoMinimo", "[", "percorsoMinimo_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "nomiCitt\[AGrave]", "}"}], ",", 
      RowBox[{
       RowBox[{"nomiCitt\[AGrave]", "=", 
        RowBox[{"percorsoMinimo", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "\"\<nome\>\""}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"StringJoin", "[", 
         RowBox[{"Riffle", "[", 
          RowBox[{"nomiCitt\[AGrave]", ",", "\"\<, \>\""}], "]"}], "]"}], 
        "]"}]}]}], "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Parametri", " ", "per", " ", 
     RowBox[{"l", "'"}], "algoritmo", " ", "di", " ", "Metropolis"}], "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"rip", "=", 
     RowBox[{"10", "*", "n"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "numero", " ", "di", " ", "ripetizioni", " ", "per", " ", "ciascuna", " ",
      "simulazione"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"beta", "=", "0.1"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"valore", " ", "di", " ", "beta"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"nTest", "=", "6"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "numero", " ", "di", " ", "volte", " ", "che", " ", "ripeto", " ", "il", 
     " ", "test", " ", "con", " ", "il", " ", "cambio", " ", "di", " ", 
     "stato", " ", "iniziale"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Inizializzazione", " ", "delle", " ", "variabili"}], "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"numAccettazioni", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"0", ",", "nTest"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"minimi", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"Infinity", ",", "nTest"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"storia", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"rip", "+", "1"}]}], "]"}], ",", "nTest"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"memorizzaPercorsi", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", "nTest"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Creazione", " ", "dello", " ", "stato", " ", "iniziale"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"statoIniz", "=", 
     RowBox[{"creaStato", "[", 
      RowBox[{"citt\[AGrave]", ",", "n"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Vettore di stato iniziale: \>\"", ",", 
      RowBox[{"stampa", "[", "statoIniz", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"stato", "=", "statoIniz"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Algoritmo", " ", "di", " ", "Metropolis"}], "*)"}], "\n", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"j", "=", "1"}], ",", 
     RowBox[{"j", "<=", "nTest"}], ",", 
     RowBox[{"j", "++"}], ",", 
     RowBox[{
      RowBox[{"stato", "=", 
       RowBox[{"creaStato", "[", 
        RowBox[{"stato", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"minimi", "[", 
        RowBox[{"[", "j", "]"}], "]"}], "=", 
       RowBox[{"distanzatot", "[", "stato", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"memorizzaPercorsi", "[", 
        RowBox[{"[", "j", "]"}], "]"}], "=", "stato"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"storia", "[", 
        RowBox[{"[", 
         RowBox[{"j", ",", "1"}], "]"}], "]"}], "=", 
       RowBox[{"distanzatot", "[", "stato", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", "rip"}], ",", 
        RowBox[{"i", "++"}], ",", 
        RowBox[{
         RowBox[{"nuovostato", "=", 
          RowBox[{"creaNuovoStato", "[", "stato", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"varCosto", "=", 
          RowBox[{
           RowBox[{"distanzatot", "[", "nuovostato", "]"}], "-", 
           RowBox[{"distanzatot", "[", "stato", "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"varCosto", "<", "0"}], "||", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "beta"}], "*", "varCosto"}], "]"}], ">", 
             RowBox[{"RandomReal", "[", "]"}]}]}], ",", 
           RowBox[{
            RowBox[{"stato", "=", "nuovostato"}], ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"numAccettazioni", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "++"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"distanzatot", "[", "stato", "]"}], "<", 
               RowBox[{"minimi", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"minimi", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "=", 
                RowBox[{"distanzatot", "[", "stato", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"memorizzaPercorsi", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "=", "stato"}], ";"}]}], 
             "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"storia", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", 
             RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "=", 
          RowBox[{"distanzatot", "[", "stato", "]"}]}], ";"}]}], "]"}], 
      ";"}]}], "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numMinSim", "=", 
     RowBox[{"Position", "[", 
      RowBox[{"minimi", ",", 
       RowBox[{"Min", "[", "minimi", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"numMinSimIndice", "=", 
     RowBox[{"numMinSim", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"percorsoMinimo", "=", 
     RowBox[{"memorizzaPercorsi", "[", 
      RowBox[{"[", "numMinSimIndice", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Percorso Minimo:\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"stampaNomiPercorsoMinimo", "[", "percorsoMinimo", "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Creazione", " ", "della", " ", "stringa", " ", "con", " ", "info", " ", 
     "sulla", " ", "simulazione"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"info", "=", 
     RowBox[{"\"\<\\nStep = \>\"", "<>", 
      RowBox[{"ToString", "[", "rip", "]"}], "<>", "\"\<, \[Beta] = \>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"beta", ",", "InputForm"}], "]"}], "<>", "\"\<, \>\"", "<>", 
      RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\< citt\[AGrave]\>\""}]}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "dei", " ", "risultati"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"minimi", ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Test\>\"", ",", "\"\<Lunghezza percorso [km]\>\""}], 
       "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"\"\<Lunghezze percorsi minimi\>\"", "<>", "info"}]}]}], "]"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calcolo", " ", "della", " ", "percentuale", " ", "di", " ", 
     "accettazione"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"percAccettazione", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"100", "*", 
        RowBox[{"(", 
         RowBox[{"numAccettazioni", "/", "rip"}], ")"}]}], ",", "3"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Lista", " ", "di", " ", "grafici", " ", "per", " ", "ogni", " ", 
     "valore", " ", "di", " ", "beta"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"grafici", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"storia", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"PlotMarkers", "->", 
          RowBox[{"{", 
           RowBox[{"\[FilledSquare]", ",", "0.001"}], "}"}]}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"GridLines", "->", "Automatic"}], ",", 
            RowBox[{"RGBColor", "[", 
             RowBox[{"0.55", ",", "0", ",", "0"}], "]"}]}], "}"}]}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Step\>\"", ",", "\"\<Lunghezza percorso [km]\>\""}], 
           "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"\"\<Evoluzione costo per beta \>\"", "<>", 
           RowBox[{"ToString", "[", "beta", "]"}], "<>", 
           "\"\<, numero di citt\[AGrave]: \>\"", "<>", 
           RowBox[{"ToString", "[", "n", "]"}], "<>", 
           "\"\<, simulazione n\[Degree]\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}]}]}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"Mesh", "->", "All"}], ",", 
         RowBox[{"MeshStyle", "->", 
          RowBox[{"{", "Red", "}"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nTest"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Mostra", " ", "i", " ", "grafici", " ", "in", " ", "una", " ", 
     "griglia"}], "*)"}], "\n", 
   RowBox[{"GraphicsGrid", "[", 
    RowBox[{"Partition", "[", 
     RowBox[{"grafici", ",", 
      RowBox[{"UpTo", "[", "2", "]"}]}], "]"}], "]"}], "\n"}]}]], "Input",
