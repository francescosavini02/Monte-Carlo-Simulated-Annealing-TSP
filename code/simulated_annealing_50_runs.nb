     RowBox[{"(*", 
      RowBox[{"DEFINIZIONE", " ", "PARAMETRI", " ", "E", " ", "VARIABILI"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ntot", "=", "4"}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
       "numero", " ", "di", " ", "volte", " ", "in", " ", "cui", " ", 
        "ricomincia", " ", "la", " ", "ricerca", " ", "del", " ", "minimo", 
        " ", "a", " ", "partire", " ", "da", " ", "un", " ", "diverso", " ", 
        "stato", " ", "inziale"}], "*)"}], "\n", 
      RowBox[{"ntemp", "=", "20"}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{"numero", " ", "di", " ", "temperature"}], "*)"}], "\n", 
      RowBox[{"nsteps", "=", 
       RowBox[{"10", "*", "n"}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
       "numero", " ", "di", " ", "step", " ", "per", " ", "ogni", " ", 
        "temperatura"}], "*)"}], "\[IndentingNewLine]", "\n", 
      RowBox[{"beta0", "=", "0.1"}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{"valore", " ", "iniziale", " ", "di", " ", "beta", " ", 
        RowBox[{"(", 
         RowBox[{"alta", " ", "temperatura"}], ")"}]}], "*)"}], 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"counter", "=", "0"}], ";", "\n", 
      RowBox[{"itot", "=", "0"}], ";", "\n", 
      RowBox[{"itemp", "=", "0"}], ";", "\n", 
      RowBox[{"isteps", "=", "0"}], ";", "\n", "\[IndentingNewLine]", 
      RowBox[{"migliorPercorso", "=", 
       RowBox[{"creaStatoIniziale", "[", 
        RowBox[{"stato", ",", "n"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"migliorDistanza", "=", 
       RowBox[{"lunghezzaTot", "[", "migliorPercorso", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"NOTA", ":", 
