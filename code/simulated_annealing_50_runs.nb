     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rand1", ",", "rand2"}], "}"}], "=", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", 
           RowBox[{"Length", "[", "stato", "]"}]}], "}"}], ",", "2"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"minRand", ",", "maxRand"}], "}"}], "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"{", 
         RowBox[{"rand1", ",", "rand2"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"invertito", "=", 
       RowBox[{"Reverse", "[", 
        RowBox[{"stato", "[", 
         RowBox[{"[", 
          RowBox[{"minRand", ";;", "maxRand"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"stato", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", 
           RowBox[{"minRand", "-", "1"}]}], "]"}], "]"}], ",", "invertito", 
        ",", 
        RowBox[{"stato", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"maxRand", "+", "1"}], ";;", 
           RowBox[{"Length", "[", "stato", "]"}]}], "]"}], "]"}]}], "]"}]}]}],
     "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"j", "=", "0"}], ";"}], "\n", 
 RowBox[{
