      RowBox[{"Print", "[", 
       RowBox[{"\"\<Distanza iniziale(km): \>\"", ",", "migliorDistanza"}], 
       "]"}], ";", "\n", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"INIZIO", " ", 
        RowBox[{"DELL", "'"}], "ALGORITMO", " ", "SIMULATED", " ", 
        "ANNEALING"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"itot", "=", "1"}], ",", 
        RowBox[{"itot", "<=", "ntot"}], ",", 
